(lang dune 3.23)
(name parser)
(sections (lib .) (libexec .) (bin ../../bin))
(files
 (lib
  (META
   dune-package
   opam
   proto/onnx.ml
   proto/onnx_proto.a
   proto/onnx_proto.cma
   proto/onnx_proto.cmi
   proto/onnx_proto.cmt
   proto/onnx_proto.cmx
   proto/onnx_proto.cmxa
   proto/onnx_proto.ml
   proto/onnx_proto__Onnx.cmi
   proto/onnx_proto__Onnx.cmt
   proto/onnx_proto__Onnx.cmx))
 (libexec (proto/onnx_proto.cmxs))
 (bin (onnx-dump)))
(library
 (name parser.proto)
 (kind normal)
 (archives (byte proto/onnx_proto.cma) (native proto/onnx_proto.cmxa))
 (plugins (byte proto/onnx_proto.cma) (native proto/onnx_proto.cmxs))
 (native_archives proto/onnx_proto.a)
 (requires ocaml-protoc-plugin)
 (main_module_name Onnx_proto)
 (modes byte native)
 (modules
  (wrapped
   (group
    (alias
     (obj_name onnx_proto)
     (visibility public)
     (kind alias)
     (source (path Onnx_proto) (impl (path proto/onnx_proto.ml-gen))))
    (name Onnx_proto)
    (modules
     (module
      (obj_name onnx_proto__Onnx)
      (visibility public)
      (source (path Onnx) (impl (path proto/onnx.ml))))))
   (wrapped true))))
